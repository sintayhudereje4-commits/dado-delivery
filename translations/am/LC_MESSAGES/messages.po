msgstr "ውይይቱ ተዘግቷል"

msgid "Page not found"
msgstr "ገጹ አልተገኘም"

msgid "Access denied"
msgstr "መግባት አይፈቀድም"

msgid "This action is not allowed here"
msgstr "ይህ ድርጊት እዚህ አይፈቀድም"

msgid "Something went wrong"
msgstr "የሆነ ችግር ተፈጥሯል"

msgid "Your session expired. Please reload the page and try again."
msgstr "ክፍለ ጊዜዎ አልፏል። እባክዎ ገጹን እንደገና ከፍተው ይሞክሩ።"

msgid "Not enough stock to re-open this order"
msgstr "ይህንን ትዕዛዝ እንደገና ለመክፈት በቂ ክምችት የለም"

msgid "The receipt must be a valid JPG, PNG, GIF or WEBP image"
msgstr "ደረሰኙ ትክክለኛ JPG፣ PNG፣ GIF ወይም WEBP ምስል መሆን አለበት"

msgid "Message too long"
msgstr "መልዕክቱ በጣም ረጅም ነው"

msgid "Too many messages. Please wait."
msgstr "ብዙ መልዕክቶች ተልከዋል። እባክዎ ይጠብቁ።"

msgid "Order sent to transporter"
msgstr "ትዕዛዙ ወደ አጓጓዡ ተልኳል"

msgid "Transporter removed from order"
msgstr "አጓጓዡ ከትዕዛዙ ተነስቷል"

msgid "Invalid hours"
msgstr "ሰዓቱ ልክ አይደለም"

msgid "Order status updated"
msgstr "የትዕዛዙ ሁኔታ ተቀይሯል"

msgid "Bank name and account number are required"
msgstr "የባንክ ስምና የአካውንት ቁጥር ያስፈልጋሉ"

msgid "Phone required"
msgstr "ስልክ ያስፈልጋል"

msgid "Phone already registered"
msgstr "ይህ ስልክ ቀድሞ ተመዝግቧል"

msgid "Transporter created"
msgstr "አጓጓዥ ተፈጥሯል"

#, python-format
msgid "Transporter created. Temporary password (shown once): %(pw)s"
msgstr "አጓጓዥ ተፈጥሯል። ጊዜያዊ የይለፍ ቃል (አንድ ጊዜ ብቻ ይታያል)፦ %(pw)s"

msgid "Current password is incorrect"
msgstr "አሁን ያለው የይለፍ ቃል ልክ አይደለም"

msgid "Confirm payment before assigning transporter"
msgstr "አጓጓዥ ከመመደብዎ በፊት ክፍያውን ያረጋግጡ"

msgid "Transporter not found or inactive"
msgstr "አጓጓዡ አልተገኘም ወይም ንቁ አይደለም"

msgid "Confirmed"
msgstr "ተረጋግጧል"

msgid "Payment status updated"
msgstr "የክፍያ ሁኔታ ተቀይሯል"

msgid "Bank account updated"
msgstr "የባንክ አካውንት ተስተካክሏል"

msgid "Transporter updated"
msgstr "አጓጓዥ ተስተካክሏል"

msgid "Username already taken"
msgstr "ይህ የተጠቃሚ ስም ተይዟል"

msgid "New passwords do not match"
msgstr "አዲሶቹ የይለፍ ቃሎች አይመሳሰሉም"

msgid "New password must be at least 8 characters"
msgstr "አዲሱ የይለፍ ቃል ቢያንስ 8 ቁምፊ መሆን አለበት"

msgid "This bank account is used by existing orders, so it was deactivated instead of deleted"
msgstr "ይህ የባንክ አካውንት በነባር ትዕዛዞች ላይ ስለተመዘገበ ከመሰረዝ ይልቅ ተሰናክሏል"

msgid "Bank account deleted"
msgstr "የባንክ አካውንት ተሰርዟል"

msgid "This transporter has past orders, so the account was deactivated instead of deleted"
msgstr "ይህ አጓጓዥ ያለፉ ትዕዛዞች ስላሉት አካውንቱ ከመሰረዝ ይልቅ ተሰናክሏል"

msgid "Transporter deleted"
msgstr "አጓጓዥ ተሰርዟል"


msgid "Please enter a valid Ethiopian phone number (e.g. 0911 234 567)"
msgstr "እባክዎ ትክክለኛ የኢትዮጵያ ስልክ ቁጥር ያስገቡ (ለምሳሌ 0911 234 567)"

msgid "Delivery location must be inside Ethiopia"
msgstr "የማድረሻ ቦታው በኢትዮጵያ ውስጥ መሆን አለበት"

msgid "Phone number and password are required"
msgstr "ስልክ ቁጥር እና የይለፍ ቃል ያስፈልጋሉ"

msgid "Phone number already registered"
msgstr "ይህ ስልክ ቁጥር ቀድሞ ተመዝግቧል"

msgid "Available weights must have a price greater than 0"
msgstr "የተመረጡ ክብደቶች ዋጋ ከ 0 በላይ መሆን አለበት"

msgid "Bulk price must be > 0 and less than or equal to regular price"
msgstr "የጅምላ ዋጋ ከ 0 በላይ እና ከመደበኛ ዋጋ በታች ወይም እኩል መሆን አለበት"

msgid "This transaction ID was already used on order %(num)s"
msgstr "ይህ የትራንዛክሽን መለያ ቀድሞ በትዕዛዝ %(num)s ላይ ተጠቅሟል"

msgid "This order does not require bank payment"
msgstr "ይህ ትዕዛዝ የባንክ ክፍያ አይፈልግም"

msgid "Payment rejected — please upload a new receipt or contact support"
msgstr "ክፍያ ውድቅ ተደርጓል — እባክዎ አዲስ ደረሰኝ ያስገቡ ወይም ድጋፍ ያነጋግሩ"

msgid "Password must be at least 6 characters"
msgstr "የይለፍ ቃል ቢያንስ 6 ቁምፊ መሆን አለበት"

msgid "Cannot change status from %(old)s to %(new)s"
msgstr "ሁኔታ ከ %(old)s ወደ %(new)s መቀየር አይቻልም"

msgid "Could not create account. Try logging in, or use a different phone number."
msgstr "አካውንት መፍጠር አልተቻለም። መግባት ይሞክሩ፣ ወይም ሌላ ስልክ ቁጥር ይጠቀሙ።"

msgid "This order is already closed — receipt cannot be changed"
msgstr "ይህ ትዕዛዝ ተዘግቷል — ደረሰኝ መቀየር አይቻልም"

msgid "A receipt was already uploaded. Contact admin to change it."
msgstr "ደረሰኝ ቀድሞ ተጭኗል። ለመቀየር አስተዳዳሪን ያነጋግሩ።"

msgid "Please enter the amount collected"
msgstr "እባክዎ የተሰበሰበውን መጠን ያስገቡ"

msgid "Receipt sent. Note: collected amount differs from order total."
msgstr "ደረሰኝ ተልኳል። ማስታወሻ፦ የተሰበሰበው መጠን ከትዕዛዝ ጠቅላላ ጋር አይዛመድም።"

msgid "Current password is incorrect"
msgstr "አሁን ያለው የይለፍ ቃል ትክክል አይደለም"

msgid "Password changed"
msgstr "የይለፍ ቃል ተቀይሯል"

msgid "Invalid status"
msgstr "ልክ ያልሆነ ሁኔታ"

msgid "Customer not found"
msgstr "ደንበኛ አልተገኘም"

msgid "Customer activated"
msgstr "ደንበኛ ተነቃቋል"

msgid "Customer blocked"
msgstr "ደንበኛ ታግዷል"

msgid "Temporary password for %(phone)s: %(pw)s — share once then customer should change it."
msgstr "ጊዜያዊ የይለፍ ቃል ለ %(phone)s፦ %(pw)s — አንድ ጊዜ ብቻ ያጋሩ ከዚያ ደንበኛው ይቀይር።"

msgid "We sent a verification code to %(phone)s"
msgstr "የማረጋገጫ ኮድ ወደ %(phone)s ልከናል"

msgid "A new code was sent to %(phone)s"
msgstr "አዲስ ኮድ ወደ %(phone)s ተልኳል"

msgid "Phone verified. Account created successfully"
msgstr "ስልክ ተረጋግጧል። አካውንት ተፈጥሯል"

msgid "Please start registration again."
msgstr "እባክዎ ምዝገባውን እንደገና ይጀምሩ።"

msgid "If this number is registered, a reset code was sent."
msgstr "ይህ ቁጥር ተመዝግቦ ከሆነ የማስመለሻ ኮድ ተልኳል።"

msgid "Password updated. You can log in now."
msgstr "የይለፍ ቃል ተዘምኗል። አሁን መግባት ይችላሉ።"

msgid "Password reset by SMS is not available right now. Contact support."
msgstr "በSMS የይለፍ ቃል ማስመለስ አሁን አይገኝም። ድጋፍ ያነጋግሩ።"

msgid "Please enter the %(n)s-digit code we sent you."
msgstr "እባክዎ የላክንልዎትን %(n)s አሃዝ ኮድ ያስገቡ።"

msgid "No active code found. Please request a new one."
msgstr "ንቁ ኮድ አልተገኘም። እባክዎ አዲስ ይጠይቁ።"

msgid "This code has expired. Please request a new one."
msgstr "ይህ ኮድ ጊዜው አልፎበታል። እባክዎ አዲስ ይጠይቁ።"

msgid "Too many wrong attempts. Please request a new code."
msgstr "በጣም ብዙ የተሳሳቱ ሙከራዎች። እባክዎ አዲስ ኮድ ይጠይቁ።"

msgid "Wrong code. %(n)s attempts left."
msgstr "የተሳሳተ ኮድ። %(n)s ሙከራዎች ቀርተዋል።"

msgid "Please wait %(n)s seconds before requesting a new code."
msgstr "አዲስ ኮድ ከመጠየቅዎ በፊት %(n)s ሰከንድ ይጠብቁ።"

msgid "Too many codes sent to this number. Please try again in an hour."
msgstr "ለዚህ ቁጥር በጣም ብዙ ኮዶች ተልከዋል። እባክዎ ከአንድ ሰዓት በኋላ ይሞክሩ።"

msgid "Could not send SMS. Please try again later or contact support."
msgstr "SMS መላክ አልተቻለም። ቆይተው ይሞክሩ ወይም ድጋፍ ያነጋግሩ።"

msgid "Could not send verification code"
msgstr "የማረጋገጫ ኮድ መላክ አልተቻለም"

msgid "Could not resend code"
msgstr "ኮድ እንደገና መላክ አልተቻለም"

msgid "Account not found"
msgstr "አካውንት አልተገኘም"

msgid "Payment proof sent. We will review it shortly."
msgstr "የክፍያ ማስረጃ ተልኳል። በቅርቡ እናረጋግጣለን።"

msgid "Mark the order out for delivery before uploading the COD receipt"
msgstr "COD ደረሰኝ ከመጫንዎ በፊት ትዕዛዙን Out for delivery ያድርጉት"

msgid "Cannot change payment status on a closed order"
msgstr "በተዘጋ ትዕዛዝ ላይ የክፍያ ሁኔታ መቀየር አይቻልም"

msgid "Collected amount (%(a)s) differs from order total (%(t)s). Enter the correct amount or contact admin."
msgstr "የተሰበሰበው መጠን (%(a)s) ከትዕዛዝ ጠቅላላ (%(t)s) ጋር አይዛመድም። ትክክለኛውን ያስገቡ ወይም አስተዳዳሪን ያነጋግሩ።"

msgid "New payment proof submitted — waiting for admin review"
msgstr "አዲስ የክፍያ ማስረጃ ተልኳል — አስተዳዳሪ እየገመገመ ነው"

msgid "Payment can only be re-submitted when pending or rejected"
msgstr "ክፍያ እንደገና የሚላከው pending ወይም rejected ሲሆን ብቻ ነው"

msgid "Cannot change status from %(old)s to %(new)s"
msgstr "ከ %(old)s ወደ %(new)s ሁኔታ መቀየር አይቻልም"

msgid "Status updated"
msgstr "ሁኔታ ተዘምኗል"

msgid "Upload COD receipt before marking delivered"
msgstr "ደርሷል ከማለትዎ በፊት COD ደረሰኝ ይጫኑ"

msgid "Password must be at least 8 characters"
msgstr "የይለፍ ቃል ቢያንስ 8 ቁምፊ መሆን አለበት"

msgid "Password must include at least 1 capital letter (A-Z)"
msgstr "የይለፍ ቃል ቢያንስ 1 አቢይ ሆሄ (A-Z) መያዝ አለበት"

msgid "Password must include at least 1 number"
msgstr "የይለፍ ቃል ቢያንስ 1 ቁጥር መያዝ አለበት"

msgid "Password must include at least 1 symbol (!@#$)"
msgstr "የይለፍ ቃል ቢያንስ 1 ምልክት (!@#$) መያዝ አለበት"

msgid "Profile updated"
msgstr "መገለጫ ተዘምኗል"

msgid "Name is required"
msgstr "ስም ያስፈልጋል"
