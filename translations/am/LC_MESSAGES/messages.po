msgstr "ሰዓቱ ልክ አይደለም"

msgid "Order status updated"
msgstr "የትዕዛዙ ሁኔታ ተቀይሯል"

msgid "Bank name and account number are required"
msgstr "የባንክ ስምና የአካውንት ቁጥር ያስፈልጋሉ"

msgid "Phone required"
msgstr "ስልክ ያስፈልጋል"

msgid "Phone already registered"
msgstr "ይህ ስልክ ቀድሞ ተመዝግቧል"

