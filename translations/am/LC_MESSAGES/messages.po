msgid "Please log in to access the admin panel."
msgstr "የአስተዳዳሪውን ገጽ ለማየት እባክዎ ይግቡ።"

msgid "Invalid security token. Please try again."
msgstr "የደህንነት ቶከኑ ልክ አይደለም። እባክዎ እንደገና ይሞክሩ።"

msgid "Confirm the bank payment before dispatching or delivering this order"
msgstr "ትዕዛዙን ከመላክዎ ወይም ከማድረስዎ በፊት የባንክ ክፍያውን ያረጋግጡ"

msgid "Logged out"
msgstr "ወጥተዋል"

msgid "Receipt sent to admin ✓"
msgstr "ደረሰኙ ወደ አስተዳዳሪው ተልኳል ✓"

msgid "Logged out — please sign in again"
msgstr "ወጥተዋል — እባክዎ እንደገና ይግቡ"

msgid "Product hidden (soft-deleted)"
msgstr "ምርቱ ተደብቋል"

msgid "Request closed"
msgstr "ጥያቄው ተዘግቷል"

msgid "File too large (max 20 MB)"
msgstr "ፋይሉ በጣም ትልቅ ነው (ቢበዛ 20 MB)"

msgid "Password must be at least 8 characters"
msgstr "የይለፍ ቃል ቢያንስ 8 ቁምፊ መሆን አለበት"

msgid "Password must contain at least 1 capital letter"
msgstr "የይለፍ ቃል ቢያንስ 1 ትልቅ ፊደል (capital) መያዝ አለበት"

msgid "Password must contain at least 1 symbol"
msgstr "የይለፍ ቃል ቢያንስ 1 ምልክት (symbol) መያዝ አለበት"

msgid "Too many attempts. Please wait a while and try again."
msgstr "ብዙ ሙከራዎች ተደርገዋል። እባክዎ ትንሽ ጠብቀው እንደገና ይሞክሩ።"

msgid "Cart is empty"
msgstr "ጋሪው ባዶ ነው"

msgid "Too many items in cart"
msgstr "በጋሪው ውስጥ ብዙ እቃዎች አሉ"

msgid "Phone number is required"
msgstr "ስልክ ቁጥር ያስፈልጋል"

msgid "Please enter a valid phone number"
msgstr "እባክዎ ትክክለኛ ስልክ ቁጥር ያስገቡ"

msgid "Please set your location on the map"
msgstr "እባክዎ ቦታዎን በካርታው ላይ ያስቀምጡ"

msgid "Your request has been submitted. We will contact you soon."
msgstr "ጥያቄዎ ተልኳል። በቅርቡ እናገኝዎታለን።"

msgid "Account created successfully"
msgstr "አካውንት በተሳካ ሁኔታ ተፈጥሯል"

msgid "Invalid email or password"
msgstr "ኢሜይል ወይም የይለፍ ቃል ልክ አይደለም"

msgid "Invalid phone or password"
msgstr "ስልክ ወይም የይለፍ ቃል ልክ አይደለም"

msgid "Not assigned to you"
msgstr "ይህ ትዕዛዝ ለእርስዎ አልተመደበም"

msgid "Status updated"
msgstr "ሁኔታው ተቀይሯል"

msgid "Receipt upload is only for orders over 100,000 ETB"
msgstr "ደረሰኝ መላክ ከ 100,000 ብር በላይ ለሆኑ ትዕዛዞች ብቻ ነው"

msgid "This order is already closed"
msgstr "ይህ ትዕዛዝ ቀድሞ ተዘግቷል"

msgid "Please choose a receipt photo"
msgstr "እባክዎ የደረሰኝ ፎቶ ይምረጡ"

msgid "Please enter a valid amount collected"
msgstr "እባክዎ የተሰበሰበውን ትክክለኛ መጠን ያስገቡ"

msgid "Could not save receipt. Use a JPG, PNG, GIF or WEBP photo."
msgstr "ደረሰኙን ማስቀመጥ አልተቻለም። JPG፣ PNG፣ GIF ወይም WEBP ፎቶ ይጠቀሙ።"

msgid "Invalid username or password"
msgstr "የተጠቃሚ ስም ወይም የይለፍ ቃል ልክ አይደለም"

msgid "Product added successfully"
msgstr "ምርቱ በተሳካ ሁኔታ ተጨምሯል"

msgid "Product updated successfully"
msgstr "ምርቱ በተሳካ ሁኔታ ተስተካክሏል"

msgid "Settings saved ✓"
msgstr "ቅንብሮች ተቀምጠዋል ✓"

msgid "Invalid cart data"
msgstr "የጋሪው መረጃ ልክ አይደለም"

msgid "Please set your exact delivery location on the map"
msgstr "እባክዎ ትክክለኛውን የመላኪያ ቦታ በካርታው ላይ ያስቀምጡ"

msgid "Invalid product in cart"
msgstr "በጋሪው ውስጥ ልክ ያልሆነ ምርት አለ"

msgid "Invalid quantity"
msgstr "ብዛቱ ልክ አይደለም"

msgid "Product unavailable"
msgstr "ምርቱ አይገኝም"

#, python-format
msgid "Not enough stock: %(name)s"
msgstr "በቂ ክምችት የለም፦ %(name)s"

msgid "Please select a bank account"
msgstr "እባክዎ የባንክ አካውንት ይምረጡ"

msgid "Send transaction ID or receipt photo"
msgstr "ትራንዛክሽን ID ወይም የደረሰኝ ፎቶ ይላኩ"

msgid "Server error. Please try again."
msgstr "የሰርቨር ስህተት ተፈጥሯል። እባክዎ እንደገና ይሞክሩ።"

msgid "Please write your message."
msgstr "እባክዎ መልዕክትዎን ይጻፉ።"

msgid "Your message is too long (max 2000 characters)."
msgstr "መልዕክትዎ በጣም ረጅም ነው (ቢበዛ 2000 ቁምፊ)።"

msgid "Too many requests. Please try again later."
msgstr "ብዙ ጥያቄዎች ተልከዋል። እባክዎ ቆይተው እንደገና ይሞክሩ።"

