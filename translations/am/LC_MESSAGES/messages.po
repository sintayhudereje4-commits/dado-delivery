msgstr "ኢሜይልና የይለፍ ቃል ያስፈልጋሉ"

msgid "Please enter a valid email address"
msgstr "እባክዎ ትክክለኛ ኢሜይል ያስገቡ"

msgid "Passwords do not match"
msgstr "የይለፍ ቃሎቹ አይመሳሰሉም"

msgid "Email already registered"
msgstr "ይህ ኢሜይል ቀድሞ ተመዝግቧል"

msgid "Too many failed attempts. Please try again in 15 minutes."
msgstr "ብዙ ያልተሳኩ ሙከራዎች ተደርገዋል። እባክዎ ከ 15 ደቂቃ በኋላ እንደገና ይሞክሩ።"

msgid "Logged in successfully"
msgstr "በተሳካ ሁኔታ ገብተዋል"

msgid "Upload COD receipt before marking delivered"
msgstr "ተደርሷል ብለው ከመመዝገብዎ በፊት የ COD ደረሰኝ ይላኩ"

msgid "Logged in"
msgstr "ገብተዋል"

msgid "The image could not be saved. Use a JPG, PNG, GIF or WEBP file."
msgstr "ምስሉን ማስቀመጥ አልተቻለም። JPG፣ PNG፣ GIF ወይም WEBP ፋይል ይጠቀሙ።"

msgid "Product names are required"
msgstr "የምርት ስሞች ያስፈልጋሉ"

